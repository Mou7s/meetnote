{
  "name": "meetnote-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1 --port 3468",
    "build": "bun --bun node_modules/nuxt/bin/nuxt.mjs build",
    "start": "bun run .output/server/index.mjs",
    "preview": "bun run start",
    "typecheck": "bun --bun node_modules/nuxt/bin/nuxt.mjs typecheck",
    "postinstall": "bun --bun node_modules/nuxt/bin/nuxt.mjs prepare",
    "test": "bun test"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "nuxt": "4.6.3",
    "ofetch": "^1.5.1",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
}
